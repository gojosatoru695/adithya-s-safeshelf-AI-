{
  "entities": {
    "Medicine": {
      "title": "Medicine",
      "description": "An item in the medicine inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "dosage": { "type": "string" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expiring", "expired", "low-stock"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "storageNotes": { "type": "string" },
        "timingSlots": { "type": "array", "items": { "type": "string", "enum": ["Morning", "Afternoon", "Evening", "Night"] } },
        "exactTimes": { "type": "array", "items": { "type": "string" } },
        "mealRelation": { "type": "string", "enum": ["Before Food", "After Food", "Empty Stomach", "None"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "repeatPattern": { "type": "string", "enum": ["Daily", "Specific Days", "Custom"] },
        "selectedDays": { "type": "array", "items": { "type": "integer" } },
        "reminderEnabled": { "type": "boolean" },
        "prescribedBy": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["name", "expiryDate", "userId", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "provider": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "preferredLanguage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "onboardingCompleted": { "type": "boolean" },
        "reminderTimes": {
          "type": "object",
          "properties": {
            "Morning": { "type": "string" },
            "Afternoon": { "type": "string" },
            "Evening": { "type": "string" },
            "Night": { "type": "string" }
          }
        }
      },
      "required": ["uid", "fullName", "email", "role", "provider", "preferredLanguage", "onboardingCompleted"]
    },
    "DoseLog": {
      "title": "DoseLog",
      "description": "History of medicine doses",
      "type": "object",
      "properties": {
        "medicineId": { "type": "string" },
        "medicineName": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["taken", "skipped", "missed"] },
        "scheduledTime": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["medicineId", "medicineName", "userId", "status", "scheduledTime", "timestamp"]
    }
  },
  "firestore": {
    "medicines/{medicineId}": {
      "schema": "Medicine",
      "description": "Collection of medicines tracked by users"
    },
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "dose_logs/{logId}": {
      "schema": "DoseLog",
      "description": "Medicine intake history"
    }
  }
}
